+        self.onLayoutFinish.append(self.refresh)
+        self.show_page(0)
+
+    @staticmethod
+    def make_pages(notes):
+        import textwrap
+
+        lines = []
+        for note in notes:
+            lines.extend(textwrap.wrap(
+                note, width=57, initial_indent=" ", subsequent_indent="  ",
+                break_on_hyphens=False,
+            ))
+        return ["\n".join(lines[i:i + 6]) for i in range(0, len(lines), 6)] or [
+            "Keine �nderungsnotizen angegeben."
+        ]
+
+    def show_page(self, step):
+        self.page_index = max(0, min(len(self.pages) - 1, self.page_index + step))
+        self["notes"].setText(self.pages[self.page_index])
+        self["page"].setText(
+            "%d/%d �   �nderungen" % (self.page_index + 1, len(self.pages))
+            if len(self.pages) > 1 else ""
+        )
+
+    def select_install(self, selected):
+        self.install_selected = selected
+        self.refresh()
+
+    def refresh(self):
+        for name, active in (("later", not self.install_selected),
+                             ("install", self.install_selected)):
+            instance = self[name].instance
+            if instance is not None:
+                instance.setBackgroundColor(parseColor("#146481" if active else "#263A4F"))
