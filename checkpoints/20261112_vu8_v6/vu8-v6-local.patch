+    def __init__(self, session, manifest):
+        Screen.__init__(self, session)
+        self["versions"] = Label("Neu %s � Installiert %s" % (
+            _embyflow_update_display_version(manifest["version"]),
+            _embyflow_update_display_version(PLUGIN_VERSION),
+        ))
+        self["notes"] = Label("")
+        self["page"] = Label("")
+        self["later"] = Label("Sp�ter")
+        self["install"] = Label("Jetzt aktualisieren")
+        self.install_selected = False
+        self.page_index = 0
+        self.pages = self.make_pages(manifest.get("changelog") or [])
+        self["actions"] = ActionMap(
+            ["OkCancelActions", "DirectionActions"],
+            {
+                "left": lambda: self.select_install(False),
+                "right": lambda: self.select_install(True),
+                "up": lambda: self.show_page(-1),
+                "down": lambda: self.show_page(1),
+                "ok": lambda: self.close(self.install_selected),
+                "cancel": lambda: self.close(False),
+            },
+            -1,
