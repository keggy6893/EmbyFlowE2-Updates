+def _embyflow_check_update_on_open(screen):
+    from threading import Thread
+
+    result = {}
+    timer = eTimer()
+
+    def fetch():
+        try:
+            manifest = _embyflow_update_fetch_manifest()
+        except Exception:
+            manifest = None
+        result["manifest"] = manifest
+
+    def stop():
+        timer.stop()
+
+    def poll():
+        if "manifest" not in result:
+            return
+        manifest = result["manifest"]
+        if (not manifest or not manifest.get("installable")
+                or manifest["build"] <= PLUGIN_UPDATE_BUILD):
+            stop()
+            return
+        if screen.session.current_dialog is not screen:
+            return
+        stop()
+
+        def notice_closed(install=False):
+            if install:
+                screen.session.open(EmbyFlowUpdateScreen, manifest)
+
+        screen.session.openWithCallback(notice_closed, EmbyFlowStartupUpdateNotice, manifest)
+
+    try:
+        timer.callback.append(poll)
+    except AttributeError:
+        screen._startup_update_timer_connection = timer.timeout.connect(poll)
+    screen._startup_update_timer = timer
+    screen.onClose.append(stop)
+    Thread(target=fetch, name="EmbyFlowStartupUpdate", daemon=True).start()
+    timer.start(250, False)
+
