+            play_background.setScale(1)
+    for key in ("detail_restart_bg", "detail_restart_btn"):
+        (self[key].show if ticks else self[key].hide)()
+    if ticks:
+        hours, remainder = divmod(ticks // 10000000, 3600)
+        minutes, seconds = divmod(remainder, 60)
+        self["detail_play_btn"].setText("Fortsetzen bei %02d:%02d:%02d" % (hours, minutes, seconds))
+        widget = self["detail_restart_bg"]
+        pixmap = images.get(self.detail_focus == 4)
+        if widget.instance and pixmap:
+            widget.instance.setPixmap(pixmap)
+            widget.instance.setScale(1)
+    rows = [("detail_play_btn", "cinema_button_bg_0")]
+    if ticks:
+        rows.append(("detail_restart_btn", "detail_restart_bg"))
+    if getattr(self, "_trailer_enabled", False):
+        rows.append(("trailer_button", "cinema_button_bg_2"))
+    if getattr(self, "_efdl_button_ready", False):
+        rows.append(("movie_download_button", "movie_download_background"))
+    rows.append(("detail_back_btn", "cinema_button_bg_1"))
+    step, height = (74, 56) if ticks else (95, 72)
+    for index, (label, background) in enumerate(rows):
+        y = 615 + index * step
+        for key, x, offset, width, extra in (
+            (label, 1510, 0, 330, 0),
+            (background, 1506, -4, 338, 8),
+        ):
+            instance = self[key].instance
+            if instance:
+                instance.move(ePoint(sx(x), sy(y + offset)))
+                instance.resize(eSize(sx(width), sy(height + extra)))
+
+
+def _detail_resume_apply(self, data):
+    result = _DETAIL_RESUME_APPLY(self, data)
+    if self._detail_resume_ready:
+        self.update_detail_focus()
+    return result
+
+
+def _detail_resume_move(self, step):
+    if not self._detail_resume_ready or not self._detail_resume_ticks:
+        return (_DETAIL_RESUME_UP if step < 0 else _DETAIL_RESUME_DOWN)(self)
+    order = [0, 4]
+    if getattr(self, "_trailer_enabled", False):
+        order.append(2)
+    if getattr(self, "_efdl_button_ready", False):
+        order.append(3)
+    order.append(1)
+    index = order.index(self.detail_focus) if self.detail_focus in order else 0
+    self.detail_focus = order[max(0, min(len(order) - 1, index + step))]
+    self.update_detail_focus()
+
+
+def _detail_resume_ok(self):
+    if self._detail_resume_ready and self.detail_focus in (0, 4):
+        if getattr(self, "_trailer_busy", False):
+            self._trs5_deferred = True
+        choice = "resume" if self.detail_focus == 0 and self._detail_resume_ticks else "restart"
+        return self.play_selected(detail_choice=choice)
+    return _DETAIL_RESUME_OK(self)
+
