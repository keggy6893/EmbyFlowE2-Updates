+def _embyflow_nfs_probe_candidates(python, candidates, expected_size, deadline, cancelled):
+    matches = set()
+    failures = set()
+    for root, candidate in sorted(candidates):
+        remaining = deadline - _nfs_time.monotonic()
+        if cancelled.is_set() or remaining <= 0:
+            return None, 'resolve-timeout'
+        try:
+            checked = _nfs_subprocess.run(
+                [python, '-c', _EMBYFLOW_NFS_PROBE, root, candidate, str(expected_size)],
+                stdout=_nfs_subprocess.PIPE, stderr=_nfs_subprocess.DEVNULL,
+                text=True, timeout=min(remaining, _EMBYFLOW_NFS_PROBE_SECONDS), check=False)
+        except _nfs_subprocess.TimeoutExpired:
+            return None, 'mount-probe-timeout'
+        except OSError:
+            return None, 'mount-probe-launch-error'
+        if checked.returncode:
+            failures.add({2: 'path-outside-mount', 3: 'file-unavailable',
+                          4: 'file-size-mismatch'}.get(checked.returncode, 'mount-probe-error'))
+            continue
+        resolved = checked.stdout.rstrip('\r\n')
+        if not resolved.startswith('/') or '\n' in resolved:
+            return None, 'mount-probe-invalid-output'
+        # Keep the validated mount path and the .ts suffix for Enigma2.
+        matches.add((resolved, candidate))
+    if not matches:
+        return None, ','.join(sorted(failures)) or 'file-unavailable'
+    if len({resolved for resolved, candidate in matches}) != 1:
+        return None, 'ambiguous-nas-file'
+    return min(candidate for resolved, candidate in matches), 'resolved'
