 EmbyFlowMoviePlayer.embyflow_media_streams_by_type = _efua_streams
 EmbyFlowMoviePlayer.embyflow_apply_confirmed_audio_track = _efua_apply
 # EMBYFLOW_UNIVERSAL_DIRECT_AUDIO_V1_20261028_END
